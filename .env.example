# Copy this file to .env and fill in real values. Never commit .env.

# Hackathon LiteLLM proxy (OpenAI-compatible)
LITELLM_API_KEY=
LITELLM_BASE_URL=

# Model names as exposed by the LiteLLM proxy (fill in from the proxy's model list)
HIOFFER_MODEL=

# neatlogs project key (from the neatlogs dashboard)
NEATLOGS_API_KEY=

# Optional
SEMANTIC_SCHOLAR_API_KEY=
CRUSTDATA_API_KEY=
