# Copy this file to .env and fill in real values. Never commit .env.

# Hackathon LiteLLM proxy (OpenAI-compatible)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

# Model names as exposed by the LiteLLM proxy (fill in from the proxy's model list)
HIOFFER_MODEL=claude-sonnet-4.6

# neatlogs project key (from the neatlogs dashboard)
NEATLOGS_API_KEY=

# Optional
SEMANTIC_SCHOLAR_API_KEY=
CRUSTDATA_API_KEY=

# Optional: your email for the OpenAlex polite pool (higher rate limits)
OPENALEX_MAILTO=
# Optional but recommended: free OpenAlex API key (https://help.openalex.org/api/authentication/)
OPENALEX_API_KEY=
